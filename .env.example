# =================================================================
# rekey — example environment configuration. Copy to .env and edit.
# =================================================================

# -----------------------------------------------------------------
# LLM provider — set ONE; rekey auto-detects in this priority order:
#   anthropic > google > openai > ollama (local)
# -----------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# OPENAI_API_KEY=sk-...

# Explicit override (skip auto-detection):
# REKEY_LLM_PROVIDER=anthropic    # anthropic | openai | google | ollama
# REKEY_LLM_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------
# Vault providers — at least one
# -----------------------------------------------------------------
# 1Password — create a service-account token at
#   https://my.1password.com/developer-tools/infrastructure-secrets/serviceaccount
# scoped to the vault(s) you want rekey to manage.
# OP_SERVICE_ACCOUNT_TOKEN=ops_eyJ...

# Bitwarden — install `bw` CLI, run `bw login` and `bw unlock`, then export:
#   export BW_SESSION="$(bw unlock --raw)"
# BW_SESSION=...

# -----------------------------------------------------------------
# Browser — Chrome must be running with:
#   /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --remote-debugging-port=9222
# -----------------------------------------------------------------
# REKEY_CDP_PORT=9222

# -----------------------------------------------------------------
# Web dashboard
# -----------------------------------------------------------------
# REKEY_WEB_HOST=127.0.0.1
# REKEY_WEB_PORT=7777
